generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// PUSAKA — Pusat Sertifikasi & Akreditasi Kompetensi
// Sistem Informasi Sertifikasi Profesi & Akreditasi Biro
// Perjalanan Wisata, Umrah & Haji
// ============================================================

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String // format: salt:hash (scrypt)
  role         String   @default("STAFF") // SUPERADMIN | STAFF
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
}

// ============================================================
// PORTAL ANGOTA LEMBAGA — akun login pemegang sertifikat
// ============================================================
model MemberAccount {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String // format: salt:hash (scrypt)
  name            String
  position        String? // jabatan pemegang akun
  institutionId   String    @unique
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
}

// ============================================================
// PAYMENT GATEWAY — invoice pembayaran biaya pendaftaran
// ============================================================
model Payment {
  id            String      @id @default(cuid())
  invoiceNo     String      @unique // INV-YYYYMMDD-XXXXXX
  trackingCode  String // kode pelacakan pengajuan terkait
  applicationId String? // relasi opsional ke Application
  application   Application? @relation(fields: [applicationId], references: [id])
  programCode   String
  method        String // QRIS | VIRTUAL_ACCOUNT | E_WALLET | CREDIT_CARD
  methodId      String // QRIS | VA-BCA | VA-MANDIRI | ... | CC
  provider      String // QRIS / BCA / Mandiri / BNI / BRI / GoPay / OVO / DANA / Kartu Kredit
  amount        Int // nominal program (IDR)
  fee           Int // biaya layanan channel (IDR)
  total         Int // amount + fee
  status        String      @default("MENUNGGU") // MENUNGGU | BERHASIL | GAGAL | KADALUARSA
  vaNumber      String? // nomor virtual account / nomor tujuan
  qrPayload     String? // payload QRIS (di-render jadi QR di client)
  reference     String? // nomor referensi pembayaran saat BERHASIL
  paidAt        DateTime?
  expiredAt     DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ============================================================
// KATALOG LAYANAN GLOBAL — 500 layanan sertifikasi & akreditasi
// lintas bidang profesional berstandar internasional
// ============================================================
model Service {
  id            String   @id @default(cuid())
  code          String   @unique // SVC-0001 .. SVC-0500
  name          String // nama layanan (konten DB — tidak diterjemahkan)
  category      String // nama bidang (Indonesia)
  categorySlug  String // slug bidang utk filter & dict i18n, mis. "manajemen-mutu"
  standard      String // referensi standar internasional (ISO/IEC, Codex, dll)
  description   String
  price         Int // biaya skema (IDR)
  durationWeeks Int // estimasi proses (minggu)
  scheme        String // BADAN_USAHA | PROFESIONAL
  scope         String // NASIONAL | INTERNASIONAL
  issuer        String // mis. "PUSAKA × JAS-ANZ (IAF MLA)"
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([categorySlug])
  @@index([scheme])
}

model Program {
  id            String   @id @default(cuid())
  code          String   @unique // PIHK, PPIU, BPW, IATA, IJIN-UMRAH, IJIN-HAJI, BPW-PRO
  name          String
  shortName     String
  category      String // PERUSAHAAN | PROFESI | IZIN
  tagline       String
  description   String
  requirements  String // JSON array of strings
  benefits      String // JSON array of strings
  durationDays  Int
  price         Int // in IDR
  seatsLeft     Int
  holderCount   Int
  passRate      Int // percentage
  accreditation String // JSON array of partner/accreditation names
  accentColor   String // tailwind-ish color key: emerald, amber, teal, rose...
  countries     String? // JSON array of {flag, country, detail} — cakupan internasional per program
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model GlobalNode {
  id          String   @id @default(cuid())
  kind        String   // KANTOR_PERWAKILAN | MITRA_INTERNASIONAL
  country     String
  countryCode String   // ISO-2, e.g. "SA" (BOLEH duplikat antar node)
  region      String   // TIMUR_TENGAH|ASIA_TENGGARA|ASIA_SELATAN|ASIA_TIMUR|EROPA|AFRIKA|AMERIKA|OSEANIA
  city        String
  flag        String   // emoji bendera
  title       String
  orgName     String
  description String
  scope       String   // JSON array of program codes
  status      String   // AKTIF | MOU | APLIKASI
  since       String   // tahun, e.g. "2018"
  contact     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Institution {
  id          String   @id @default(cuid())
  name        String
  type        String // PPIU | PIHK | BPW | IATA
  city        String
  province    String
  certNumber  String   @unique // e.g. PPU-2025-0184
  programCode String
  status      String // AKTIF | DIPERBARUI | KADALUARSA
  tier        String // SILVER | GOLD | PLATINUM
  score       Int // audit score 0-100
  issuedAt    DateTime
  expiresAt   DateTime
  contact     String?
  phone       String?
  createdAt   DateTime @default(now())
  memberAccount MemberAccount?
}

model Expert {
  id              String  @id @default(cuid())
  name            String
  field           String // bidang utama: Hukum, Ibadah, Aviasi, dst
  expertise       String // deskripsi keahlian
  category        String // HUKUM | IBADAH | AVIASI | MANAJEMEN | KEUANGAN | TEKNOLOGI | KESEHATAN | BAHASA | LOGISTIK
  licenseNo       String  @unique
  experienceYears Int
  organization    String
  education       String
  initials        String
  featured        Boolean @default(false)
  createdAt       DateTime @default(now())
}

model Application {
  id           String   @id @default(cuid())
  trackingCode String   @unique // PSK-2025-XXXXX
  applicantType String // PERUSAHAAN | INDIVIDU
  programCode  String
  fullName     String
  email        String
  phone        String
  institution  String?
  city         String
  message      String?
  status       String   @default("SUBMITTED") // SUBMITTED | REVIEW | VERIFIKASI | ASSESSMENT | APPROVED
  paymentStatus String  @default("BELUM_BAYAR") // BELUM_BAYAR | MENUNGGU | LUNAS
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  payments     Payment[]
}

model VerifyLog {
  id         String   @id @default(cuid())
  certNumber String
  result     String // VALID | INVALID
  createdAt  DateTime @default(now())
}

model NewsArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  category    String // PENGUMUMAN | REGULASI | KEGIATAN | KEMITRAAN
  author      String
  featured    Boolean  @default(false)
  publishedAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}
